# ── 淡江大學領袖禪學社 AI 代理 · 設定檔範本 ──────────────────────
# 用法：把這個檔案複製一份改名為 .env，再把下面的值填進去。
# .env 不會被上傳、不會被 git 追蹤，金鑰只留在你自己電腦上。

# ── 1. NVIDIA Build 免費模型（必填）────────────────────────────
# 到 https://build.nvidia.com/settings/api-keys 產生金鑰（免費、不用信用卡）
NVIDIA_API_KEY=nvapi-請填入你的金鑰

# OpenAI 相容端點，通常不用改
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 主力模型：要支援 function calling（工具呼叫），否則代理無法「動手做」
#   meta/llama-3.1-70b-instruct          ← 穩，預設
#   meta/llama-3.3-70b-instruct
#   nvidia/llama-3.3-nemotron-super-49b-v1.5
#   moonshotai/kimi-k2-instruct
#   qwen/qwen2.5-72b-instruct
#   mistralai/mixtral-8x22b-instruct
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# 選用：加入圖片時使用支援圖片輸入的模型；留空則沿用 NVIDIA_MODEL。
NVIDIA_VISION_MODEL=

# ── 2. 認證（部署時務必設定）──────────────────────────────────
# 不填 = 本機單人模式，不需要登入。
# 填了 = 部署模式，要先輸入這組存取碼才能使用，
#        而且每個瀏覽器會拿到獨立身分，幹部之間的對話與產出互相隔離。
#
# **部署到 Zeabur 一定要設。** 不設的話任何拿到網址的人都能用、
# 消耗你的 NVIDIA 額度，還看得到彼此的檔案。
APP_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=
# 一般授權 cookie 名稱與有效期限（秒）
ACCESS_CODE_COOKIE_NAME=tku_zen_access
ACCESS_CODE_COOKIE_MAX_AGE=2592000
ADMIN_COOKIE_MAX_AGE=43200

# 想強制指定模式時才填（local / token）。留空會自動判斷。
AUTH_MODE=

# ── 3. 產出落點 ──────────────────────────────────────────────
# local = 只存本機、drive = 只上傳 Google 雲端硬碟、both = 兩邊都要
# 部署到伺服器時建議用 drive —— 容器重啟後本機檔案會消失。
DEFAULT_DESTINATION=local
OUTPUT_DIR=outputs

# ── 4. 資料庫與當期狀態 ───────────────────────────────────────
# session / project / artifact 都存在這個 SQLite。
# 部署時如果平台有持久化磁碟，把它指到掛載點才不會重開就消失。
DB_PATH=data/agent.sqlite3

# 本學期真實資料（社長、社課時間、社費…）。
# 第一次啟動會自動從 data/current_term.example.yaml 複製一份。
# 平常用網頁介面右上角的「本學期設定」編輯就好，不用手改。
CURRENT_TERM_FILE=data/current_term.yaml

# ── 5. Google 雲端硬碟（選用）────────────────────────────────
DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json

# ── 6. LINE 語料（預設關閉）──────────────────────────────────
# 設成 true 才會把 LINE 記錄納入檢索範圍。
# 開啟後被檢索到的對話片段會隨提問送到 NVIDIA 的伺服器。
ENABLE_LINE_CORPUS=false

# ── 7. 伺服器 ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8848
