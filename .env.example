# ── 淡江大學領袖禪學社 AI 代理 · 設定檔範本 ──────────────────────
# 用法：把這個檔案複製一份改名為 .env，再把下面的值填進去。
# .env 不會被上傳、不會被 git 追蹤，金鑰只留在你自己電腦上。

# ── 1. 文字模型供應商（必填其一）──────────────────────────────
# 兩家都是 OpenAI 相容端點，只差設定；不填 LLM_PROVIDER 時，
# 有 ZEABUR_API_KEY 就走 zeabur，否則走 nvidia。
LLM_PROVIDER=zeabur

# (A) Zeabur AI Hub —— 一把金鑰通到 GPT／Claude／Gemini／Grok
#     後台：Zeabur Dashboard → AI Hub → API Keys（預付點數計費）
ZEABUR_API_KEY=

# (B) NVIDIA Build —— 免費額度、開源模型
#     https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# 端點與模型：留空就用該供應商的預設值。
#   zeabur 預設 https://hnd1.aihub.zeabur.ai/v1（東京；美西改 sfo1）
#   nvidia 預設 https://integrate.api.nvidia.com/v1
LLM_BASE_URL=

# 主力模型：要支援 function calling（工具呼叫），否則代理無法「動手做」。
#   Zeabur AI Hub：gpt-4o（預設）／gpt-4o-mini／claude-3-5-sonnet／
#                  claude-3-opus／gemini-2.0-flash／grok-2
#   NVIDIA Build ：meta/llama-3.1-70b-instruct（預設）／meta/llama-3.3-70b-instruct／
#                  nvidia/llama-3.3-nemotron-super-49b-v1.5／moonshotai/kimi-k2-instruct
LLM_MODEL=
# 短查詢用的輕量模型與長文／研究用的強模型（留空用預設）
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
# 介面下拉可選的模型清單（逗號分隔，留空用供應商預設清單）
LLM_KNOWN_MODELS=
# 想看美元成本估算才填單價（Zeabur 是點數、NVIDIA 是額度，預設顯示 0）
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=

# ── fal.ai 視覺服務（選用）────────────────────────────────────
# 文字走上方供應商；圖片的**輸入（理解上傳的照片／海報）與輸出（生成視覺稿）**都走 fal.ai。
# 到 https://fal.ai/dashboard/keys 建立 FAL_KEY；沒有設定也不影響純文字任務。
FAL_KEY=
# 可依 fal.ai 帳號已啟用模型調整；一般情況可保留預設。
FAL_VISION_MODEL=google/gemini-2.5-flash
# Optional endpoint that understands a full video and returns timestamped segments.
# Leave empty until an approved video provider is deployed; a poster frame is
# never represented as a fake timeline.
FAL_VIDEO_ENDPOINT=
# Optional approved audio transcription endpoint returning timestamped segments.
AUDIO_TRANSCRIPTION_ENDPOINT=
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# ── duigao Asset Intelligence server-to-server adapter ────────────
# 與 duigao Supabase Edge Function 使用同一個隨機 secret；不要放前端。
DUIGAO_CONTEXT_SHARED_SECRET=
DUIGAO_CONTEXT_MAX_SKEW_SECONDS=300
# true when this tku deployment forwards media to an external provider. If a
# private/self-hosted provider is used, set false so external_ai_allowed=false
# assets may be processed under the room's approved internal policy.
DUIGAO_ANALYSIS_PROVIDER_EXTERNAL=true

# ── 2. 認證（部署時務必設定）──────────────────────────────────
# 不填 = 本機單人模式，不需要登入。
# 填了 = 部署模式，要先輸入這組存取碼才能使用，
#        而且每個瀏覽器會拿到獨立身分，幹部之間的對話與產出互相隔離。
#
# **部署到 Zeabur 一定要設。** 不設的話任何拿到網址的人都能用、
# 消耗你的 NVIDIA 額度，還看得到彼此的檔案。
APP_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=
# 一般授權 cookie 名稱與有效期限（秒）
ACCESS_CODE_COOKIE_NAME=tku_zen_access
ACCESS_CODE_COOKIE_MAX_AGE=2592000
ADMIN_COOKIE_MAX_AGE=43200

# 想強制指定模式時才填（local / token）。留空會自動判斷。
AUTH_MODE=

# ── Instagram 公開 hashtag 搜尋（需 Meta App Review）─────────────
# token 只能放在 server-side 環境，不要放入前端或提交到 Git。
INSTAGRAM_APP_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_PUBLIC_SEARCH_ENABLED=false
INSTAGRAM_API_TIMEOUT_SECONDS=15
PUBLIC_SOURCE_TIMEOUT_SECONDS=12
PUBLIC_SOURCE_MAX_BYTES=2000000
PUBLIC_SOURCE_MAX_TEXT_CHARS=12000
PUBLIC_SOURCE_MAX_SOURCES=4
# ── Perplexity 公開網路研究（需 server-only API key）────────────
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_SEARCH_ENABLED=false
PERPLEXITY_SEARCH_TIMEOUT_SECONDS=20
PERPLEXITY_SEARCH_ATTEMPTS=2

# ── 2b. 對外發佈總開關（預設關閉＝草稿模式）───────────────────
# 不填或填 0 = 任何人（含管理者）都拿不到「核准發佈」與「動用額度」權限，
#              Instagram 發文／回覆留言／傳送訊息一律擋下，只會產生草稿。
# 填 1        = 管理者才「可能」取得這兩項權限，且每次操作仍要帶明確的
#              confirm=true 確認；缺任一條件都會被擋下（fail closed）。
EXTERNAL_PUBLISH_ENABLED=

# ── 2c. API 限流 ──────────────────────────────────────────────
# /api/chat 會呼叫外部模型（消耗 NVIDIA 額度），所以獨立設一組較嚴的上限。
CHAT_RATE_LIMIT=12
CHAT_RATE_WINDOW=60
# 其餘 API 的每 IP 上限
API_RATE_LIMIT=240
API_RATE_WINDOW=60

# ── 3. 產出落點 ──────────────────────────────────────────────
# local = 只存本機、drive = 只上傳 Google 雲端硬碟、both = 兩邊都要
# 部署到伺服器時建議用 drive —— 容器重啟後本機檔案會消失。
DEFAULT_DESTINATION=local
OUTPUT_DIR=outputs

# ── 4. 資料庫與當期狀態 ───────────────────────────────────────
# session / project / artifact 都存在這個 SQLite。
# 部署時如果平台有持久化磁碟，把它指到掛載點才不會重開就消失。
DB_PATH=data/agent.sqlite3

# 視覺資料庫（部署時請和 DB_PATH 一起掛到持久化磁碟）
VISUAL_ASSET_DIR=data/visual-assets
VISUAL_EXPORT_DIR=outputs/visual-exports
VISUAL_MAX_FILE_BYTES=20000000
VISUAL_MAX_BATCH=30
VISUAL_SEARCH_LIMIT=60

# ── InsForge 視覺資料層（選用；預設 local fallback）────────────
# 只在伺服器環境設定，絕不放進前端。先在 InsForge 套用 migrations/insforge/001_visual_backend.sql。
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
INSFORGE_SERVICE_KEY=
INSFORGE_OWNER_ID=
INSFORGE_STORAGE_BUCKET=visual-assets
INSFORGE_SEARCH_RPC=visual_hybrid_search
INSFORGE_FUNCTION_PREFIX=functions
INSFORGE_TIMEOUT_SECONDS=15
# GET/HEAD/OPTIONS 遇到 429/5xx 或網路失敗時最多再試幾次（不含第一次）。
# POST/PATCH/PUT/DELETE 不會在 transport 層自動重試，避免 timeout 後重複寫入。
# 金鑰只放 server，不要填進前端。
INSFORGE_HTTP_ATTEMPTS=2
# 必須明確信任遠端服務；否則不會上傳 binary 或呼叫搜尋/function。
INSFORGE_TRUSTED=false
INSFORGE_SYNC_MODE=local
# private 圖片額外 opt-in；預設 false。
INSFORGE_ALLOW_PRIVATE_SYNC=false
# Artifact 原檔、知識庫文字與同步並行度都需明確設定；metadata 仍可獨立同步。
INSFORGE_ALLOW_ARTIFACT_FILE_SYNC=false
INSFORGE_ALLOW_KNOWLEDGE_SYNC=false
INSFORGE_ALLOW_CONVERSATION_KNOWLEDGE_SYNC=false
INSFORGE_SYNC_LIMIT=5000
INSFORGE_SYNC_WORKERS=6

# 內部本機素材整理白名單（逗號分隔，相對於專案根目錄）；只讀取支援的媒體／文件格式。
DATA_ORGANIZATION_IMPORT_ROOTS=data,output,outputs,mobile-shots

# 本學期真實資料（社長、社課時間、社費…）。
# 第一次啟動會自動從 data/current_term.example.yaml 複製一份。
# 平常用網頁介面右上角的「本學期設定」編輯就好，不用手改。
CURRENT_TERM_FILE=data/current_term.yaml

# ── 5. Google 雲端硬碟（選用）────────────────────────────────
DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json

# ── 6. LINE 語料（預設關閉）──────────────────────────────────
# 設成 true 才會把 LINE 記錄納入檢索範圍。
# 開啟後被檢索到的對話片段會隨提問送到 NVIDIA 的伺服器。
ENABLE_LINE_CORPUS=false

# ── 7. 伺服器 ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8848
